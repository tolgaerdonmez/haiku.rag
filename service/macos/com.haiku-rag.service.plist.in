<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>

    <!-- The launcher holds the Full Disk Access grant and runs the service. -->
    <key>ProgramArguments</key>
    <array>
        <string>@LAUNCHER@</string>
        <string>@SERVE@</string>
    </array>

    <!-- launchd listens on the port and starts the service on the first
         connection; the launcher hands the socket on. -->
    <key>Sockets</key>
    <dict>
        <key>Listeners</key>
        <dict>
            <key>SockNodeName</key>
            <string>127.0.0.1</string>
            <key>SockServiceName</key>
            <string>@PORT@</string>
            <key>SockFamily</key>
            <string>IPv4</string>
            <key>SockType</key>
            <string>stream</string>
        </dict>
    </dict>

    <!-- At login, to index what changed while it was not running. -->
    <key>RunAtLoad</key>
    <true/>
    <!-- Restarted after a crash; an idle exit waits for the next request. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- Longer than ingester.workers.shutdown_grace_s (60 s): the launcher
         waits for the service, which releases its jobs before it exits. -->
    <key>ExitTimeOut</key>
    <integer>90</integer>

    <!-- Background holds the whole process tree to the efficiency cores;
         Nice 10, low-priority I/O and the throttle keep Standard light. -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>LowPriorityBackgroundIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>HAIKU_RAG_CONFIG_PATH</key>
        <string>@CONFIG@</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>@STATE_DIR@</string>
    <key>StandardOutPath</key>
    <string>@STATE_DIR@/service.log</string>
    <key>StandardErrorPath</key>
    <string>@STATE_DIR@/service.log</string>
</dict>
</plist>
